# --- Telegram ---
# Get this from @BotFather when you create your bot.
TELEGRAM_BOT_TOKEN=

# The public HTTPS URL where your Mini App frontend is hosted.
# Set this as your bot's Mini App URL via @BotFather (/newapp or /setmenubutton).
MINI_APP_URL=https://your-domain.example.com

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/kingdom_rush

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Auth / secrets ---
JWT_SECRET=replace-with-a-long-random-string
ADMIN_SECRET=replace-with-a-long-random-string

# --- Redis (added when caching/leaderboards are wired up) ---
REDIS_URL=redis://localhost:6379

# --- Payments (Telegram Stars) ---
# Telegram Stars purchases go through Telegram's own invoice flow using the
# bot token above — no separate payment provider secret is required for
# Stars specifically. This placeholder exists for wiring a payment
# provider_token if you later add a non-Stars payment method.
PAYMENT_PROVIDER_TOKEN=

# --- Ads ---
# Fill in once you've picked a rewarded-ads provider supported inside
# Telegram Mini Apps. Left blank, the ads route (added in a later phase)
# will run in a disabled/no-op mode rather than fake a completed ad.
AD_PROVIDER_API_KEY=
AD_PROVIDER_APP_ID=
