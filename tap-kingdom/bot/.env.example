# Get this from @BotFather when you create your bot. Never commit the real
# value or send it to the client — only this bot process ever reads it.
TELEGRAM_BOT_TOKEN=

# The public HTTPS URL where the client (Mini App frontend) is hosted.
# Set this as your bot's Mini App URL via @BotFather (/newapp or /setmenubutton).
MINI_APP_URL=https://your-domain.example.com

# Port the bot's HTTP API (invoice creation + entitlements) listens on.
PORT=4001

# Origin(s) allowed to call the HTTP API — normally just the Mini App's own origin.
CLIENT_ORIGIN=http://localhost:5173
